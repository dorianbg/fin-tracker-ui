# Required — encrypts/decrypts the Parquet files the UI reads
PARQUET_ENCRYPTION_KEY=your-secret-key-here

# Optional — only needed if running `make pipeline-postgres`
POSTGRES_HOST=100.108.3.21
POSTGRES_PORT=5432
POSTGRES_DB=fintracker
PGUSER=db_admin
PGPASSWORD=your-postgres-password

# Optional — required only for email alert scripts
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_USER=alerts@example.com
SMTP_PASSWORD=your-smtp-password
EMAIL_SENDER=alerts@example.com
EMAIL_RECIPIENTS=you@example.com

# Optional — testing/development only. Normal alert sends require today's data date.
FINTRACKER_ALLOW_STALE_ALERTS=0
